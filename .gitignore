# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*/
.test-tmp/
.coverage
htmlcov/
*.egg-info/

# Local runtime configuration and artifacts
config.local.json
.panel-jobs.json
data/
output/
[Dd]ata/
[Ii]nput/
[Oo]utput/
results/
audit_csv/
strategies/
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.xlsx

# Raw tester exports and temporary files
*.html
# Synthetic test fixtures are not raw exports: they are a few KB of hand-written
# markup the suite cannot run without. Without this three v6 fixtures were
# ignored and the tests that read them failed on a fresh clone.
!tests/fixtures/**/*.html
*.log
*.tmp

# Agent workspaces
.superpowers/
.worktrees/

# Local generated evidence and temporary probes
.codex/
external-coder/
.stage1-pytest-*/
.task*
tmp-strict*/
posttest_*/
